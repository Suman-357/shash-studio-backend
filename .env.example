# Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection URI (Local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/shash_studios

# JWT Secret & Expiry for Admin Authentication
JWT_SECRET=shash_studios_super_secure_mysuru_secret_key_2026
JWT_EXPIRE=30d

# Allowed Client Origins for CORS (comma-separated if multiple)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiter Window (in ms) & Max Requests
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Razorpay Payment Gateway (Test Mode: rzp_test_... / Live Mode: rzp_live_...)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_optional
